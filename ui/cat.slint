// The break window, always an overlay: fullscreen, frameless and see-through,
// so the cat is drawn straight over the desktop. On X11, Windows and macOS it
// also stays on top; Wayland has no way to ask for that (winit), so there it's
// a fullscreen window like any other.
export component CatWindow inherits Window {
    title: "catnap";
    no-frame: true;
    background: transparent;
    always-on-top: true;

    // catnap's icon as pixels, for X11 taskbars (see app.slint).
    in property <image> window-icon;
    icon: root.window-icon;

    in property <image> frame;
    // Set to true just after the window shows: the cat slides in from the right.
    in property <bool> arrived;
    // Time left in the break, "m:ss".
    in property <string> countdown;
    in property <string> hold-text: "Hold to dismiss";
    // 0..1, driven from Rust (hold.rs) while the button is held.
    in property <float> hold-progress;
    callback hold-pressed();
    callback hold-released();

    // The clip keeps its shape (16:9 until its first frame): as big as the
    // screen allows, at the bottom right. It slides in by its own width, so
    // a cat cut off by the clip's right edge comes in from off-screen.
    property <float> clip-aspect: root.frame.height > 0 ? (root.frame.width * 1.0) / root.frame.height : 16.0 / 9.0;

    Image {
        width: min(root.width, root.height * root.clip-aspect);
        height: self.width / root.clip-aspect;
        x: root.arrived ? root.width - self.width : root.width;
        y: root.height - self.height;
        source: root.frame;
        image-fit: contain;
        // Timed to the ginger cat's walk (CLAUDE.md §5): its footage follows
        // the cat, so this slide is the walk. Walking speed first, slowing as
        // the cat stops; the paws stay put within 25 px on a 1920 px screen.
        animate x {
            duration: 2.6s;
            easing: cubic-bezier(0.60, 0.70, 0.75, 0.90);
        }
    }

    // Countdown badge: big white digits on an rgba(0,0,0,0.6) rounded box
    // (CLAUDE.md §1). Fixed width, so it doesn't jitter as digits change.
    Rectangle {
        width: 180px;
        height: 76px;
        x: parent.width - self.width - 40px;
        y: 40px;
        border-radius: 14px;
        background: #00000099;

        Text {
            text: root.countdown;
            color: white;
            font-size: 44px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Hold-to-dismiss: ends the break early. rgba(0,0,0,0.6) pill, filled
    // from the left while held.
    Rectangle {
        width: 320px;
        height: 56px;
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 64px;
        border-radius: self.height / 2;
        background: #00000099;
        clip: true;

        Rectangle {
            x: 0;
            y: 0;
            width: parent.width * root.hold-progress;
            height: parent.height;
            background: #ffffff55;
        }

        Text {
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: root.hold-progress > 0 ? "Keep holding…" : root.hold-text;
            color: white;
            font-size: 18px;
        }

        TouchArea {
            mouse-cursor: pointer;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.hold-pressed();
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    root.hold-released();
                }
            }
        }
    }
}
