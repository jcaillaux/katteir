// Colours, font sizes and spacing shared by every window.
export global Theme {
    out property <color> background: #1f2630;
    out property <color> surface: #2b3440;
    out property <color> surface-hover: #36414f;
    out property <color> text: #e8ecf1;
    out property <color> text-muted: #9aa6b2;
    // Ginger-cat orange.
    out property <color> accent: #f0a53a;
    out property <color> accent-text: #1f2630;
    out property <color> ok: #6cc070;
    out property <color> error: #e5675e;

    out property <length> radius: 6px;
    out property <length> spacing: 8px;
    out property <length> padding: 16px;
    out property <length> control-height: 30px;
    out property <length> label-width: 160px;
    out property <length> stepper-width: 36px;

    out property <length> font-size: 14px;
    out property <length> font-size-small: 12px;
    out property <length> font-size-title: 20px;
}
