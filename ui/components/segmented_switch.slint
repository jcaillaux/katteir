import { Theme } from "../theme.slint";

// Pick one of a few options, shown side by side.
export component SegmentedSwitch inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;

    height: Theme.control-height;
    border-radius: Theme.radius;
    background: Theme.surface;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;

        for option[index] in root.options: Rectangle {
            min-width: 96px;
            border-radius: Theme.radius - 2px;
            background: index == root.selected ? Theme.accent : (touch.has-hover ? Theme.surface-hover : transparent);

            Text {
                text: option;
                color: index == root.selected ? Theme.accent-text : Theme.text;
                font-size: Theme.font-size;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.selected = index;
                }
            }
        }
    }
}
