import { Theme } from "theme.slint";
import { PillButton } from "components/pill_button.slint";
import { NumberField } from "components/number_field.slint";
import { PathField } from "components/path_field.slint";
import { CheckBox } from "components/check_box.slint";
// The app's name, from Cargo.toml, and the build's clip-fields feature
// (generated by build.rs).
import { AppInfo } from "@app-info";

export { CatWindow } from "cat.slint";

// Allowed range of a number field, from src/limits.rs.
export struct IntRange {
    min: int,
    max: int,
}

// What closing the settings window does: unknown while the tray icon is
// still registering.
export enum TrayHint { unknown, in-tray, no-tray }

component SectionTitle inherits Text {
    color: Theme.text-muted;
    font-size: Theme.font-size-small;
    font-weight: 700;
}

export component SettingsWindow inherits Window {
    title: AppInfo.name;
    background: Theme.background;
    preferred-width: 560px;
    default-font-size: Theme.font-size;

    // Config values: set from Rust at startup and read back on Save.
    in-out property <int> work-minutes: 25;
    in-out property <int> warn-before-secs: 60;
    in-out property <int> break-secs: 300;
    in-out property <int> dismiss-hold-secs: 5;
    in-out property <string> entry-clip;
    in-out property <string> loop-clip;

    in property <IntRange> work-range: { min: 1, max: 180 };
    in property <IntRange> warn-range: { min: 0, max: 300 };
    in property <IntRange> break-range: { min: 10, max: 3600 };
    in property <IntRange> hold-range: { min: 1, max: 30 };

    in property <string> entry-clip-status;
    in property <int> entry-clip-status-kind;
    in property <string> loop-clip-status;
    in property <int> loop-clip-status-kind;

    // Timer state, refreshed from Rust.
    in property <string> status: "Idle";
    in property <bool> can-start: true;
    in property <bool> can-pause;
    in property <bool> can-stop;
    in property <string> notice;
    // Warnings (adjusted values, unusable clips, a failed save) show in red.
    in property <bool> notice-is-warning;
    in property <string> config-path;
    in property <TrayHint> tray-hint;
    // The icon as pixels, for X11 taskbars (_NET_WM_ICON). Wayland ignores
    // it; there the icon comes from the desktop entry.
    in property <image> window-icon;
    icon: root.window-icon;

    callback start();
    callback pause();
    callback stop();
    callback save();
    // Start at login: applied at once, not by Save (src/autostart.rs).
    in-out property <bool> start-at-login;
    callback start-at-login-toggled(bool);
    // 0 = entry clip, 1 = loop clip.
    callback clip-edited(int, string);

    VerticalLayout {
        padding: Theme.padding;
        spacing: Theme.spacing;

        HorizontalLayout {
            spacing: Theme.spacing;
            Text {
                text: AppInfo.name;
                color: Theme.text;
                font-size: Theme.font-size-title;
                font-weight: 700;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                text: root.status;
                color: Theme.accent;
                font-size: Theme.font-size;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            spacing: Theme.spacing;
            alignment: LayoutAlignment.start;
            PillButton {
                text: "Start";
                primary: true;
                enabled: root.can-start;
                clicked => {
                    root.start();
                }
            }
            PillButton {
                text: "Pause";
                enabled: root.can-pause;
                clicked => {
                    root.pause();
                }
            }
            PillButton {
                text: "Stop";
                enabled: root.can-stop;
                clicked => {
                    root.stop();
                }
            }
        }

        SectionTitle { text: "TIMER"; }
        NumberField {
            label: "Work";
            unit: "min";
            minimum: root.work-range.min;
            maximum: root.work-range.max;
            step: 5;
            value <=> root.work-minutes;
        }
        NumberField {
            label: "Warn before the break";
            unit: "s (0 = off)";
            minimum: root.warn-range.min;
            maximum: root.warn-range.max;
            step: 15;
            value <=> root.warn-before-secs;
        }
        NumberField {
            label: "Break";
            unit: "s";
            minimum: root.break-range.min;
            maximum: root.break-range.max;
            step: 30;
            value <=> root.break-secs;
        }

        // The clip paths show only in builds with the clip-fields feature
        // (a dev tool); elsewhere they're set in the config file.
        SectionTitle { text: AppInfo.clip-fields ? "CAT (STACKED-ALPHA AV1 .IVF CLIPS)" : "CAT"; }
        if AppInfo.clip-fields: PathField {
            label: "Entry clip";
            path <=> root.entry-clip;
            status: root.entry-clip-status;
            status-kind: root.entry-clip-status-kind;
            edited(path) => {
                root.clip-edited(0, path);
            }
        }
        if AppInfo.clip-fields: PathField {
            label: "Loop clip";
            path <=> root.loop-clip;
            status: root.loop-clip-status;
            status-kind: root.loop-clip-status-kind;
            edited(path) => {
                root.clip-edited(1, path);
            }
        }
        NumberField {
            label: "Hold to dismiss";
            unit: "s";
            minimum: root.hold-range.min;
            maximum: root.hold-range.max;
            value <=> root.dismiss-hold-secs;
        }

        HorizontalLayout {
            spacing: Theme.spacing;
            PillButton {
                text: "Save";
                primary: true;
                clicked => {
                    root.save();
                }
            }
            Text {
                horizontal-stretch: 1;
                text: root.notice;
                color: root.notice-is-warning ? Theme.error : Theme.text-muted;
                font-size: Theme.font-size-small;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }

        Text {
            text: "Config file: " + root.config-path;
            color: Theme.text-muted;
            font-size: Theme.font-size-small;
            wrap: word-wrap;
        }

        SectionTitle { text: "STARTUP"; }
        CheckBox {
            label: "Start at login";
            checked <=> root.start-at-login;
            toggled(on) => {
                root.start-at-login-toggled(on);
            }
        }
        Text {
            text: "At login, " + AppInfo.name + " starts in the tray with the timer running.";
            color: Theme.text-muted;
            font-size: Theme.font-size-small;
            wrap: word-wrap;
        }

        if root.tray-hint != TrayHint.unknown: Text {
            text: root.tray-hint == TrayHint.in-tray
                ? "Closing this window keeps " + AppInfo.name + " running in the tray."
                : "No tray found: closing this window quits " + AppInfo.name + ".";
            color: Theme.text-muted;
            font-size: Theme.font-size-small;
            wrap: word-wrap;
        }
    }
}
