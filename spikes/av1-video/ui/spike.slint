// Throwaway spike window: shows one video frame (a borrowed GL texture) over a
// flat "desktop" colour, or over nothing in see-through mode, with a
// press-and-hold dismiss button on top of the video.
export component SpikeWindow inherits Window {
    title: "catnap AV1 spike";
    preferred-width: 1280px;
    preferred-height: 720px;

    // See-through mode (SPIKE_SEE_THROUGH=1): no background and no frame, so
    // the cat is drawn straight over the desktop.
    in property <bool> see-through: false;
    // SPIKE_ON_TOP=1: always on top and frameless. The window level is a
    // no-op on Wayland (winit), so this only takes effect on X11/Windows/macOS.
    in property <bool> keep-on-top: false;
    in property <bool> frameless: false;
    background: root.see-through ? transparent : #2b3a4a;
    no-frame: root.see-through || root.frameless;
    always-on-top: root.keep-on-top;

    in property <image> frame;
    in property <string> stats;
    // 0..1, driven from Rust (hold.rs) while the button is held.
    in property <float> hold-progress: 0;
    callback hold-pressed();
    callback hold-released();

    Image {
        width: parent.width;
        height: parent.height;
        source: root.frame;
        image-fit: contain;
    }

    Text {
        x: 8px;
        y: 8px;
        text: root.stats;
        color: white;
        font-size: 14px;
    }

    // Dismiss button: rgba(0,0,0,0.6) pill, filled from the left while held.
    Rectangle {
        width: 280px;
        height: 56px;
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 48px;
        border-radius: self.height / 2;
        background: #00000099;
        clip: true;

        Rectangle {
            x: 0;
            y: 0;
            width: parent.width * root.hold-progress;
            height: parent.height;
            background: #ffffff55;
        }

        Text {
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: root.hold-progress > 0 ? "Keep holding…" : "Hold 5 s to dismiss";
            color: white;
            font-size: 18px;
        }

        TouchArea {
            mouse-cursor: pointer;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.hold-pressed();
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    root.hold-released();
                }
            }
        }
    }
}
