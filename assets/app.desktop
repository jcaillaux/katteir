# Template: the Makefile fills in @NAME@, @ID@ and @EXEC@ from Cargo.toml
# ([package.metadata.packager]), for `make install-desktop` and `make deb`.
[Desktop Entry]
Type=Application
Name=@NAME@
Comment=Every N minutes of work, a cat takes over the screen for a short break
Exec=@EXEC@
Icon=@ID@
Terminal=false
Categories=Utility;
StartupWMClass=@ID@
